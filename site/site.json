eUrl":"","data":{"target":"초등학생, 중고등학생","topic":"자기이해와 성장","category":"교육 프로그램","goals":[],"v":"v7","schoolLevels":["초등","중등","고등"],"keywords":["스트레스 인식","자기돌봄","스트레스 대처","도움요청"],"duration":"2시간","composition":{"version":1,"sections":[{"id":"program-overview","type":"overview","enabled":true,"kicker":"PROGRAM OVERVIEW","title":"프로그램 소개","description":""},{"id":"program-related","type":"related","enabled":true,"kicker":"MORE PROGRAMS","title":"다른 교육도 살펴보세요.","description":"","buttonLabel":"전체 프로그램 보기","buttonHref":"#/programs"},{"id":"program-cta","type":"cta","enabled":true,"kicker":"NEXT STEP","title":"이 교육을 문의해 주세요.","description":"대상과 일정, 교육 목적을 알려주세요.","buttonLabel":"이 교육 문의하기","buttonHref":""}]}},"version":0,"createdAt":"2026-10-18T00:00:00.000Z","updatedAt":"2026-10-18T00:00:00.000Z"},{"id":"page-about","collection":"pages","slug":"about","title":"에듀모션 소개","summary":"관계를 배우는 경험이, 삶의 변화를 만듭니다.","body":"사람을 이해하고, 함께 살아가는 힘을 배웁니다.\n\n에듀모션은 자기이해에서 시작해 타인과의 관계, 생명과 마음을 돌보는 배움까지 사람의 성장에 필요한 교육을 만들어갑니다.\n\n지식을 전달하는 데 그치지 않고, 직접 경험하고 소통하며 일상에서 실천할 수 있는 교육을 지향합니다.","status":"published","sortOrder":0,"imageUrl":"","data":{},"version":0,"createdAt":"2026-10-18T00:00:00.000Z","updatedAt":"2026-10-18T00:00:00.000Z"},{"id":"page-solution","collection":"pages","slug":"solution","title":"학교 맞춤 솔루션","summary":"정해진 교육을 제공하는 것을 넘어, 학교의 상황에 맞게 함께 고민합니다.","body":"학교와 학급의 상황에 맞춰 교육 목적과 대상, 현장의 필요를 상담하고 운영 방향을 논의합니다.\n\n문의 → 진단·사정 → 개입 → 평가 → 사후관리\n\n세부 운영 범위와 절차는 담당자의 최신 자료 검수를 거쳐 확정합니다.","status":"published","sortOrder":0,"imageUrl":"","data":{},"version":0,"createdAt":"2026-10-18T00:00:00.000Z","updatedAt":"2026-10-18T00:00:00.000Z"},{"id":"page-partnership","collection":"pages","slug":"partnership","title":"기업·기관 협력","summary":"더 나은 배움의 경험, 함께 만들어갑니다.","body":"학교뿐 아니라 기업과 지역 기관이 교육의 변화를 함께 만들어갈 수 있도록 협력 사업을 소개합니다. 최신 협력 사례는 확인 후 반영합니다.","status":"published","sortOrder":0,"imageUrl":"","data":{},"version":0,"createdAt":"2026-10-18T00:00:00.000Z","updatedAt":"2026-10-18T00:00:00.000Z"}],"settings":{"site":{"name":"에듀모션","tagline":"관계를 배우는 경험이, 삶의 변화를 만듭니다.","description":"관계, 소통, 회복을 중심으로 사람을 이해하고 함께 살아가는 힘을 배우는 교육을 만들어갑니다.","contactEmail":"","contactPhone":"","address":"","inquiryEnabled":false,"privacyText":""},"home":{"eyebrow":"EDUCATION FOR CONNECTION","title":"사람을 이해하고,\n관계의 변화를\n만드는 교육.","description":"관계를 배우고 서로 소통하며, 더 건강한 공동체와 사회를 만들어가는 교육. 에듀모션은 경험을 통해 함께 성장하는 과정을 고민합니다.","ctaLabel":"교육 프로그램 살펴보기","ctaHref":"#/programs","secondaryLabel":"맞춤형 교육 문의하기","secondaryHref":"#/contact","imageUrl":"","featuredIds":["program-class-cohesion","program-social-skills","program-life-respect"],"showStories":true,"showPartnership":true}}}